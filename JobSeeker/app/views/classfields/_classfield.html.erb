  <%= turbo_frame_tag "modal" do %>
  <div class="modal-background" data-controller="modal" data-action="click->modal#close">
    <div id="<%= dom_id classfield %>" class="modal-content">
      <%#<button class="modal-close" data-action="click->modal#close">&times;</button%>
      <div class="classfield">
        <h2><%= classfield.title %></h2>
        <p><strong>Creator:</strong> <%= classfield.user.name %></p>
        <p><strong>Description:</strong> <%= classfield.description %></p>
        <p><strong>Category:</strong> <%= classfield.category.title %></p>
        <p><strong>Tags:</strong> <%= @tags.map(&:name).join(", ") %></p>
        <p><strong>Status:</strong> <%= classfield.status %></p>
        <p><strong>Last updated:</strong> <%= classfield.updated_at %></p>
      </div>
      <% if classfield.user != current_user && @classfield.applications.where(user: current_user).empty? && user_signed_in? %>
        <%= form_with(url: classfield_applications_path(classfield), method: :post, data:{turbo_frame: "_top"}) do %>
        <div class="submit-button" >
          <%= submit_tag "Apply for this job" %>
        </div>
        <% end %>
      <% end %>

      <% if classfield.user == current_user %>
        <div class="mt-4">
          <%= link_to 'View Applicants', classfield_applications_path(classfield), data: { turbo: false } %>
          <%= link_to "Edit this classfield", edit_classfield_path(classfield),data: { turbo: false } %> |
          <%= button_to "Destroy this classfield", classfield, method: :delete %>
        </div>
    <% end %>
  </div>
  </div>
<%end%>
